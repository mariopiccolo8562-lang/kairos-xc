    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="8dp" /><stroke android:width="3dp" android:color="@color/accent" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="8dp" /></shape></item>
</selector>
