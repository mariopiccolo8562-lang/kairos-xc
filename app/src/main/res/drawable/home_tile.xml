<?xml version="1.0" encoding="utf-8"?>
<!-- pulsanti piccoli della Home (in alto e in basso) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#FFFF6A1F" android:endColor="#FFFF2D6F" />
        <corners android:radius="16dp" /><stroke android:width="2dp" android:color="#FFFFFFFF" />
    </shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#FFFF6A1F" android:endColor="#FFFF2D6F" />
        <corners android:radius="16dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="#990B0912" /><corners android:radius="16dp" /><stroke android:width="1dp" android:color="#47FFFFFF" />
    </shape></item>
</selector>
