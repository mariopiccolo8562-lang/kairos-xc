<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|right"
        android:alpha="0.55"
        android:scaleType="centerCrop" />
    <View
        android:id="@+id/shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30C0E13" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/pad">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/topbar_h"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/back"
                style="@style/IconBtn"
                android:contentDescription="Indietro"
                android:src="@drawable/ic_back" />
            <TextView
                android:id="@+id/kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_m"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gap"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/posterBox"
                android:layout_width="@dimen/poster_w"
                android:layout_height="@dimen/poster_h"
                android:background="@drawable/bg_ph">
                <ImageView
                    android:id="@+id/poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text"
                    android:textSize="@dimen/hero"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text2"
                    android:textSize="@dimen/text_m"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/plot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="4"
                    android:maxWidth="560dp"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_m" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/play"
                        style="@style/Btn.Primary"
                        android:layout_width="wrap_content"
                        android:drawableLeft="@drawable/ic_play"
                        android:text="Guarda" />
                    <Button
                        android:id="@+id/restart"
                        style="@style/Btn"
                        android:layout_width="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Dall'inizio"
                        android:visibility="gone" />
                    <Button
                        android:id="@+id/trailer"
                        style="@style/Btn"
                        android:layout_width="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Trailer"
                        android:visibility="gone" />
                    <ImageButton
                        android:id="@+id/fav"
                        style="@style/IconBtn"
                        android:layout_height="@dimen/btn_h"
                        android:layout_width="@dimen/btn_h"
                        android:layout_marginLeft="10dp"
                        android:contentDescription="Preferito"
                        android:src="@drawable/ic_heart" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/epBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seasons"
                style="@style/List"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodes"
                style="@style/List"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_s"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
