<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_h"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/back"
            style="@style/IconBtn"
            android:contentDescription="Indietro"
            android:src="@drawable/ic_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:text="Live TV"
            android:textColor="@color/text"
            android:textSize="@dimen/title"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/catName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_m" />
        <Button
            android:id="@+id/search"
            style="@style/Btn"
            android:layout_width="wrap_content"
            android:drawableLeft="@drawable/ic_search"
            android:text="Cerca" />
        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap"
        android:layout_weight="1"
        android:orientation="horizontal">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cats"
            style="@style/List"
            android:layout_width="@dimen/cat_w"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel"
            android:padding="6dp" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/gap"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channels"
                style="@style/List"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="20dp"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_m"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/preview"
            android:layout_width="@dimen/preview_w"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/gap"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/pbox"
                android:layout_width="match_parent"
                android:layout_height="@dimen/preview_h"
                android:background="@drawable/bg_ph">
                <ImageView
                    android:id="@+id/plogo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />
                <FrameLayout
                    android:id="@+id/pvideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <ProgressBar
                    android:id="@+id/pspin"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/phint"
                    android:layout_width="wrap_content"
                    android:maxWidth="230dp"
                    android:ellipsize="end"
                    android:layout_height="24dp"
                    android:layout_gravity="top|right"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:background="@drawable/dot_red" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="LIVE"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/pch"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:maxWidth="260dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <TextView
                android:id="@+id/nowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="@dimen/text_l"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/nowRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/nowTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_s"
                    android:textStyle="bold" />
                <ProgressBar
                    android:id="@+id/nowBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_thin" />
                <TextView
                    android:id="@+id/nowLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_s" />
            </LinearLayout>
            <TextView
                android:id="@+id/nowDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="3"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_s" />
            <TextView
                android:id="@+id/next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel"
                android:ellipsize="end"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/text2"
                android:textSize="@dimen/text_s"
                android:visibility="gone" />
            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/watch"
                    style="@style/Btn.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Guarda" />
                <ImageButton
                    android:id="@+id/fav"
                    style="@style/IconBtn"
                    android:layout_height="@dimen/btn_h"
                    android:layout_width="@dimen/btn_h"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="Preferito"
                    android:src="@drawable/ic_heart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
