<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/pv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/spin"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay"
        android:gravity="center"
        android:maxWidth="560dp"
        android:padding="22dp"
        android:textColor="@color/text"
        android:textSize="@dimen/text_l"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_badge"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:textColor="@color/text"
        android:textSize="@dimen/text_m"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- risoluzione e FPS dei canali in diretta (permesso «resInd»): solo indicazione, non prende il focus né i tasti -->
    <TextView
        android:id="@+id/res"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_margin="@dimen/pad"
        android:background="@drawable/bg_badge"
        android:clickable="false"
        android:focusable="false"
        android:paddingBottom="6dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/zap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_margin="28dp"
        android:background="@drawable/bg_overlay"
        android:paddingBottom="10dp"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="10dp"
        android:textColor="@color/text"
        android:textSize="36sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/pad"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/back"
            style="@style/IconBtn"
            android:contentDescription="Indietro"
            android:src="@drawable/ic_back" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:background="@drawable/bg_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">
            <FrameLayout
                android:id="@+id/logoBox"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_ph">
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="3dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="8dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="420dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_l"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="420dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text2"
                    android:textSize="@dimen/text_m" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/pad"
        android:background="@drawable/bg_overlay"
        android:orientation="vertical"
        android:paddingBottom="14dp"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="16dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="@dimen/text_s"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/time"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/progress_thin" />
            <TextView
                android:id="@+id/tEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text2"
                android:textSize="@dimen/text_s"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text2"
                android:textSize="@dimen/text_s" />
            <ImageButton
                android:id="@+id/prev"
                style="@style/IconBtn"
                android:contentDescription="Precedente"
                android:src="@drawable/ic_prev" />
            <ImageButton
                android:id="@+id/playPause"
                style="@style/IconBtn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:background="@drawable/bg_btn_primary"
                android:contentDescription="Pausa"
                android:padding="15dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/on_accent" />
            <ImageButton
                android:id="@+id/next"
                style="@style/IconBtn"
                android:contentDescription="Successivo"
                android:src="@drawable/ic_next" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/subs"
                    style="@style/IconBtn"
                    android:contentDescription="Sottotitoli"
                    android:src="@drawable/ic_subtitles" />
                <ImageButton
                    android:id="@+id/audio"
                    style="@style/IconBtn"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="Audio"
                    android:src="@drawable/ic_audio" />
                <ImageButton
                    android:id="@+id/list"
                    style="@style/IconBtn"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="Lista canali"
                    android:src="@drawable/ic_list" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_s" />
    </LinearLayout>
</FrameLayout>
