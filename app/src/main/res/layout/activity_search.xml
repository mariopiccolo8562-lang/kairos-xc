<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/pad">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_h"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/back"
            style="@style/IconBtn"
            android:contentDescription="Indietro"
            android:src="@drawable/ic_back" />
        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="@dimen/icon_btn"
            android:layout_marginLeft="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Cerca canali, film e serie"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/dim"
            android:textSize="@dimen/text_m" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results"
            style="@style/List"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Scrivi almeno 2 lettere"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_m" />
    </FrameLayout>
</LinearLayout>
