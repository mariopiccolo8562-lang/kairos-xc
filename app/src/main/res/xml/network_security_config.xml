<?xml version="1.0" encoding="utf-8"?>
<!-- Molti flussi IPTV sono in http: il traffico in chiaro va consentito.
     La comunicazione con il pannello Cloudflare resta sempre in https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
